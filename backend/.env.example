TUMAINI_APP_NAME=Tumaini School System API
TUMAINI_ENVIRONMENT=development
TUMAINI_DATABASE_URL=sqlite:///./tumaini_school.db
TUMAINI_FRONTEND_URL=http://localhost:5173

# SMS provider options: console, twilio, africastalking
TUMAINI_SMS_PROVIDER=console
TUMAINI_SMS_SENDER_ID=Tumaini
TUMAINI_SMS_TIMEOUT_SECONDS=20

# Twilio
TUMAINI_TWILIO_ACCOUNT_SID=
TUMAINI_TWILIO_AUTH_TOKEN=
TUMAINI_TWILIO_FROM_NUMBER=

# Africa's Talking
TUMAINI_AFRICASTALKING_USERNAME=
TUMAINI_AFRICASTALKING_API_KEY=
